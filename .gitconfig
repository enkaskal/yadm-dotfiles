[alias]
  l = log --show-signature
  co = checkout
  b = branch
  cob = checkout -b
  cot = checkout -t
  com = checkout master
  a = add
  aa = add --all
  s = status
  sho = show --show-signature
  d = diff
  dc = diff --cached
  p = pull --rebase
  cv = commit -v
  ca = commit -av
  caa = commit -av --amend
  cm = commit -m
  cam = commit -am
  sl = stash list
  se = send-email
  r = remote -v

[user]
  name = Stefan Schwoegler
  email = stefan@cryp7.net
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJf9ewizLQdZO7uTxZFceOOsmDaBN7BDzygsBa2untVy

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[include]
  path = ~/.gitconfig.gpg.ssh

[push]
  default = current

[core]
  excludesfile = ~/.gitignore

[init]
  defaultBranch = master

[sendemail]
  smtpServer = msmtp
  annotate = yes
[pull]
	rebase = true
