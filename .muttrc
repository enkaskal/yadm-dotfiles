# user config
set realname  = "Stefan Schwoegler"
set from = "stefan@cryp7.net"

# behavior
#set mark_old = no # don't mark mail O on exit (i.e. disable N->O flagging)
set move = yes # move read messages from spoolfile to mbox on exit or mbox-hook
set pager_stop = yes # disable moving messages when paging (i.e. page-up/down)

# binds/macros
bind index G imap-fetch-mail
macro index,pager A "<save-message>=[Gmail]/All%20Mail<enter>"

# receiving config
set imap_user = "stefan@cryp7.net"
set imap_authenticators="oauthbearer:xoauth2"
set imap_oauth_refresh_command="mutt_oauth2.py ${HOME}/.mutt/mutt_oauth2.tokens"
set folder = "imaps://imap.gmail.com:993"
set spoolfile = "+INBOX"
set postponed="imaps://imap.gmail.com/[Gmail]/Drafts"
set mbox="imaps://imap.gmail.com/[Gmail]/All Mail"
set trash = "imaps://imap.gmail.com/[Gmail]/Bin"

# sending config
set smtp_authenticators=${imap_authenticators}
set smtp_oauth_refresh_command=${imap_oauth_refresh_command}
set sendmail = "sendgmail -sender=stefan@cryp7.net"
set copy = no # disable mutt's storing of all sent mail

# caching
set message_cachedir = ${HOME}/.mutt/cache/messages
set message_cache_clean = no
set header_cache = ${HOME}/.mutt/cache/headers

# index config
set index_format="%4C %Z %(%FT%T%z) [%4.4c] %-33.33L %s"

## non-threading - be like gmail
#set sort=reverse-date-received

## threading - be sane!
set sort=reverse-threads
set sort_aux=date-received

# pager
auto_view text/html

# colors
#
# color object [ attribute ... ] foreground background [ regexp ]
# color index [ attribute ... ] foreground background [ pattern ]
# color compose composeobject [ attribute ... ] foreground background
# uncolor index pattern [ pattern ... ]
#
# Valid objects are: attachment, body, bold, error,  header,  hdrdefault,  index,  indicator,
#   markers, message, normal, prompt, quoted, quotedN, search, signature, status, tilde, tree, underline.
# If sidebar is enabled the following objects are also valid: sidebar_divider, sidebar_flagged, sidebar_highlight,
#   sidebar_indicator,  sidebar_new,  sidebar_spoolfile.
#
# The  body and header objects allow you to restrict the colorization to a regular expression.
# The index object permits you to select colored messages by pattern.
#
# Valid composeobjects include header, security_encrypt, security_sign, security_both, security_none.
#
# Valid colors include: white, black, green, magenta, blue, cyan, yellow, red, default, colorN.
#
# Valid attributes include: none, bold, underline, reverse, and standout.

## patches
## ref: https://github.com/jessfraz/dockerfiles/blob/master/mutt/.mutt/mutt-patch-highlighting.muttrc
color body brightred default ^(Breaking-Change).*
color body cyan default ^(Signed-off-by).*
## ref: https://karelzak.blogspot.com/2010/02/highlighted-patches-inside-mutt.html
color body yellow default "^diff \-.*"
color body yellow default "^index [a-f0-9].*"
color body yellow default "^\-\-\- .*"
color body yellow default "^[\+]{3} .*"
color body green default "^[\+][^\+]+.*"
color body red  default "^\-[^\-]+.*"
color body brightblue default "^@@ .*"
